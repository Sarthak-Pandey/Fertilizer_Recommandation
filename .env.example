# ============================================================
# Fertilizer Recommendation System -- Environment Variables
# ============================================================

# Backend
BACKEND_PORT=8000
ML_SERVICE_URL=http://localhost:8001
ML_REQUEST_TIMEOUT=10
DATABASE_URL=sqlite:///./predictions.db

# ML Service
MODEL_VERSION=v1

# Docker/PostgreSQL (used with --profile postgres)
POSTGRES_DB=fertilizer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=5432

# Debug
DEBUG=false
PYTHONIOENCODING=utf-8
